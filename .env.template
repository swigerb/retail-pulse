# Azure Developer CLI environment configuration
# Copy this file to .azure/<env-name>/.env and fill in values

# Required: Azure region for deployment
AZURE_LOCATION=northcentralus

# Required: Environment name (dev, staging, prod)
AZURE_ENV_NAME=dev

# Optional: Azure OpenAI endpoint (if using Azure OpenAI directly)
# If using APIM AI Gateway, configure APIM endpoint in app settings instead
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
