# .NET
bin/
obj/
*.user
*.suo
*.cache
*.vs/
.vs/
*.DotSettings.user
publish/

# Node / React
node_modules/
dist/
.vite/

# Test result artifacts (TRX / coverage) — machine-generated, never committed
test-results/
test-results-matrix/
*.trx

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# SQLite database files
data/*.db
data/*.db-shm
data/*.db-wal
*.db
*.db-shm
*.db-wal

# External reference repos (clone separately)
ai-gateway-dev-portal/

# Secrets — never commit
appsettings.*.local.json
**/appsettings.Development.json
# Per-project base appsettings.json is the checked-in reference config
# (safe defaults only; real secrets live in user-secrets / env / Key Vault).

# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
# Squad: ignore runtime state (logs, inbox, sessions)
.squad/.scratch/
# Squad: per-run evidence captures (API policy dumps, diagnostics, run logs).
# Useful while investigating; never part of the source of truth.
.squad/evidence/
# Squad: local backups an agent takes before rewriting its own charter/agent file
*.local-backup
# Squad: `squad triage --execute` runtime state. Both are per-machine bookkeeping for the
# watch loop (spawned child PIDs, and the failure/rate-limit breaker), so committing either
# would push one machine's transient state onto everyone else's.
.squad/.watch-pids
.squad/ralph-circuit-breaker.json

# Agent scratch space: transcripts, doc dumps, URL lists gathered during a run
.scratch/

# Ad-hoc verification output kept while chasing a live issue
prod-verify*.json

# Azure Developer CLI
.azure/
.squad/.cache/

# Local CI log dumps
ci-*.log
