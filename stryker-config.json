{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/stryker-config.schema.json",
  "stryker-config": {
    "project": "RetailPulse.Api.csproj",
    "test-projects": ["tests/RetailPulse.Tests/RetailPulse.Tests.csproj"],
    "mutate": [
      "src/RetailPulse.Api/Agents/Routing/**/*.cs",
      "src/RetailPulse.Api/Validation/**/*.cs",
      "src/RetailPulse.Api/Caching/**/*.cs"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "reporters": ["html", "progress", "cleartext"],
    "concurrency": 4,
    "language-version": "preview",
    "solution": "RetailPulse.slnx"
  }
}
