<policies>
  <inbound>
    <base />
    <!-- Caller auth (ADR 017): pinned-issuer Entra v2 token, exact client-id audience, invoke role. -->
    <validate-jwt header-name="Authorization" failed-validation-httpcode="401" require-expiration-time="true" require-signed-tokens="true" clock-skew="60" output-token-variable-name="callerJwt">
      <openid-config url="https://login.microsoftonline.com/{{tenantId}}/v2.0/.well-known/openid-configuration" />
      <audiences>
        <audience>{{mcpGatewayAudience}}</audience>
      </audiences>
      <issuers>
        <issuer>https://login.microsoftonline.com/{{tenantId}}/v2.0</issuer>
      </issuers>
      <required-claims>
        <claim name="roles" match="any">
          <value>RetailPulse.Mcp.Invoke</value>
        </claim>
      </required-claims>
    </validate-jwt>
    <!-- MCP transport verbs only; tool operations themselves are GET-only (backing API). -->
    <choose>
      <when condition="@(context.Request.Method != &quot;POST&quot; &amp;&amp; context.Request.Method != &quot;GET&quot; &amp;&amp; context.Request.Method != &quot;DELETE&quot;)">
        <return-response>
          <set-status code="405" reason="Method Not Allowed" />
        </return-response>
      </when>
    </choose>
    <!--
      Do not authorize tools from context.Operation here. This policy also evaluates native MCP
      transport requests (including initialize), whose operation id is not a backing REST operation.
      The MCP tool resources, GET-only backing API, and API-side app-only route allow-list enforce
      the four-tool boundary.
    -->
    <rate-limit-by-key calls="30" renewal-period="60" counter-key="@(context.Subscription.Id)" />
    <quota-by-key calls="2000" bandwidth="20480" renewal-period="86400" counter-key="@(context.Subscription.Id)" />
    <!-- Backend identity: the caller token is never forwarded; APIM presents its own managed identity token. -->
    <set-header name="Authorization" exists-action="delete" />
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <authentication-managed-identity resource="{{retailPulseApiAudience}}" output-token-variable-name="backendToken" ignore-error="false" />
    <set-header name="Authorization" exists-action="override">
      <value>@("Bearer " + (string)context.Variables["backendToken"])</value>
    </set-header>
    <set-backend-service base-url="https://{{retailPulseApiFqdn}}" />
  </inbound>
  <backend>
    <forward-request timeout="30" />
  </backend>
  <outbound>
    <base />
    <!-- Telemetry without payloads: server, tool, caller scope, latency, outcome. No policy reads the response body. -->
    <emit-metric name="mcp_gateway_calls" namespace="retailpulse_mcp" value="@(context.Elapsed.TotalMilliseconds)">
      <dimension name="mcp_server" value="retail-pulse-mcp-server" />
      <dimension name="tool" value="@(context.Operation != null ? context.Operation.Id : &quot;mcp-transport&quot;)" />
      <dimension name="caller_scope" value="RetailPulse.Mcp.Invoke" />
      <dimension name="outcome" value="@(context.Response.StatusCode.ToString())" />
      <dimension name="subscription" value="@(context.Subscription != null ? context.Subscription.Id : &quot;none&quot;)" />
    </emit-metric>
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
