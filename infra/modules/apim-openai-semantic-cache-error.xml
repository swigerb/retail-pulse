        <!-- #339: an error raised by a semantic-cache policy is reported as unavailable evidence only; no detail leaks. -->
        <choose>
            <when condition="@(context.LastError != null &amp;&amp; context.LastError.Source != null &amp;&amp; context.LastError.Source.Contains(&quot;semantic-cache&quot;))">
                <set-header name="x-rp-gw-cache" exists-action="override">
                    <value>unavailable</value>
                </set-header>
                <set-header name="x-rp-gw-cache-reason" exists-action="override">
                    <value>cache-error</value>
                </set-header>
            </when>
        </choose>
