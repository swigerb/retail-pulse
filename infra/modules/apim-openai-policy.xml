<policies>
    <inbound>
        <base />
        <!-- Evidence headers are set only by APIM; drop any client-supplied values. -->
        <set-header name="x-rp-backend-id" exists-action="delete" />
        <set-header name="x-rp-failover" exists-action="delete" />
        <set-backend-service backend-id="{backend-id}" />
        <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
        <azure-openai-token-limit counter-key="@(context.Subscription.Id)"
            tokens-per-minute="{tokens-per-minute}" estimate-prompt-tokens="true"
            tokens-consumed-header-name="x-tokens-consumed"
            retry-after-header-name="Retry-After" />
        <azure-openai-emit-token-metric namespace="RetailPulse">
            <dimension name="API ID" value="@(context.Api.Id)" />
            <dimension name="Operation ID" value="@(context.Operation.Id)" />
            <dimension name="Subscription ID" value="@(context.Subscription.Id)" />
        </azure-openai-emit-token-metric>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
        <!-- Non-sensitive route evidence: backend id and whether the secondary served the request. -->
        <set-variable name="rpServedBySecondary" value="@(context.Request.Url.Host == &quot;{secondary-backend-host}&quot;)" />
        <set-header name="x-rp-backend-id" exists-action="override">
            <value>@((bool)context.Variables["rpServedBySecondary"] ? "{secondary-backend-id}" : "{primary-backend-id}")</value>
        </set-header>
        <set-header name="x-rp-failover" exists-action="override">
            <value>@(((bool)context.Variables["rpServedBySecondary"]).ToString().ToLowerInvariant())</value>
        </set-header>
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
