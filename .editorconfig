# Top-level EditorConfig — applies to all files in the repository
root = true

# Default settings for all files
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown files
[*.md]
trim_trailing_whitespace = false

# YAML files
[*.{yaml,yml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# C# files
[*.cs]
# Organize usings
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Namespace preferences
csharp_style_namespace_declarations = file_scoped:warning

# var preferences
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_indexers = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion
csharp_style_expression_bodied_lambdas = true:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion

# Null checking
csharp_style_throw_expression = true:suggestion
csharp_style_conditional_delegate_call = true:suggestion
csharp_style_prefer_null_check_over_type_check = true:suggestion

# Code block preferences
csharp_prefer_braces = when_multiline:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# Space preferences
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true

# ── Naming Rules ─────────────────────────────────────────────────────────────

# Public members: PascalCase
dotnet_naming_rule.public_members_must_be_pascal_case.severity = warning
dotnet_naming_rule.public_members_must_be_pascal_case.symbols = public_symbols
dotnet_naming_rule.public_members_must_be_pascal_case.style = pascal_case_style

dotnet_naming_symbols.public_symbols.applicable_kinds = property, method, field, event, delegate
dotnet_naming_symbols.public_symbols.applicable_accessibilities = public, internal, protected, protected_internal

dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# Private fields: _camelCase
dotnet_naming_rule.private_fields_must_be_camel_case.severity = warning
dotnet_naming_rule.private_fields_must_be_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_must_be_camel_case.style = underscore_camel_case_style

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_must_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_must_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_must_begin_with_i.style = interface_style

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.interface_style.required_prefix = I
dotnet_naming_style.interface_style.capitalization = pascal_case

# Type parameters: TPascalCase
dotnet_naming_rule.type_parameters_must_begin_with_t.severity = warning
dotnet_naming_rule.type_parameters_must_begin_with_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_must_begin_with_t.style = type_parameter_style

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_symbols.type_parameters.applicable_accessibilities = *

dotnet_naming_style.type_parameter_style.required_prefix = T
dotnet_naming_style.type_parameter_style.capitalization = pascal_case

# ── Analyzer Severity ────────────────────────────────────────────────────────

# Keep analyzers at warning level (not error) to avoid breaking builds
dotnet_analyzer_diagnostic.severity = warning

# Suppress noisy warnings that don't add value
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0055.severity = suggestion
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0290.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1062.severity = none

# CA1873: LoggerMessage source generators — premature optimization for this workload
# Current structured logging with ILogger is sufficient; revisit under high-throughput scenarios
dotnet_diagnostic.CA1873.severity = suggestion

# CA1816: GC.SuppressFinalize — only relevant for classes with unmanaged resources
# Most Dispose implementations in this codebase wrap managed IDisposable dependencies
dotnet_diagnostic.CA1816.severity = suggestion

# IDE0060: Remove unused parameter — often required by interface contracts or event handlers
dotnet_diagnostic.IDE0060.severity = suggestion

# CA2016: Forward CancellationToken — suggestion level; not all call sites support cancellation
dotnet_diagnostic.CA2016.severity = suggestion

# CA1806: Ignoring return value — common in fire-and-forget patterns
dotnet_diagnostic.CA1806.severity = suggestion

# CA2263: Prefer generic overload — suggestion for gradual adoption
dotnet_diagnostic.CA2263.severity = suggestion

# CA1869: Cache and reuse JsonSerializerOptions — suggestion level
dotnet_diagnostic.CA1869.severity = suggestion

# CA1862: Use StringComparison overload — covered by CA1311
dotnet_diagnostic.CA1862.severity = suggestion

# CA2201: Do not raise reserved exception types — suggestion for gradual adoption
dotnet_diagnostic.CA2201.severity = suggestion

# CA1861: Avoid constant arrays as arguments — micro-optimization, suggestion level
dotnet_diagnostic.CA1861.severity = suggestion

# CA1836: Prefer IsEmpty over Count — suggestion for gradual adoption
dotnet_diagnostic.CA1836.severity = suggestion

# CA1725: Parameter names should match base — suggestion level
dotnet_diagnostic.CA1725.severity = suggestion

# CA1716: Identifiers should not match keywords — suggestion level
dotnet_diagnostic.CA1716.severity = suggestion

# CA1711: Identifiers should not have incorrect suffix — suggestion level
dotnet_diagnostic.CA1711.severity = suggestion

# CA1001: Types that own disposable fields — suggestion level
dotnet_diagnostic.CA1001.severity = suggestion

# IDE0040: Add accessibility modifiers — already enforced by default style but not auto-fixable everywhere
dotnet_diagnostic.IDE0040.severity = suggestion

# IDE0052: Remove unread private member — suggestion level (may be used via reflection/DI)
dotnet_diagnostic.IDE0052.severity = suggestion

# IDE0200: Remove unnecessary lambda — suggestion level
dotnet_diagnostic.IDE0200.severity = suggestion

# CA1860: Prefer `.Length > 0` over `.Any()` — micro-optimization
dotnet_diagnostic.CA1860.severity = suggestion

# CA1826: Use .First() instead of indexer[0] — micro-optimization
dotnet_diagnostic.CA1826.severity = suggestion

# CA1859: Use concrete types for better performance — suggestion level
dotnet_diagnostic.CA1859.severity = suggestion

# IDE0130: Namespace doesn't match folder — intentional for DI extension classes
dotnet_diagnostic.IDE0130.severity = suggestion

# CA1707: Identifiers should not contain underscores — intentional for enum naming
dotnet_diagnostic.CA1707.severity = suggestion

# CA1310: Specify StringComparison for correctness — suggestion level
dotnet_diagnostic.CA1310.severity = suggestion

# ── Test project overrides ────────────────────────────────────────────────────

# Test projects use underscores in method names (convention)
[*Tests*.cs]
dotnet_diagnostic.CA1707.severity = none

# Tests don't need globalization or strict naming/performance rules
[tests/**.cs]
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1304.severity = suggestion
dotnet_diagnostic.CA1311.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
dotnet_diagnostic.CA1859.severity = suggestion
dotnet_diagnostic.CA1822.severity = suggestion
dotnet_diagnostic.CA1860.severity = suggestion
dotnet_diagnostic.IDE1006.severity = suggestion
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.xUnit1004.severity = none
dotnet_diagnostic.xUnit1031.severity = suggestion
dotnet_diagnostic.xUnit1042.severity = suggestion
dotnet_diagnostic.ASP0015.severity = suggestion

# MCP simulated data layer — generated test data, not production logic
[src/RetailPulse.McpServer/Data/**.cs]
dotnet_diagnostic.IDE1006.severity = suggestion
dotnet_diagnostic.CA1305.severity = suggestion
dotnet_diagnostic.CA1310.severity = suggestion
