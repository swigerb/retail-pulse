{
  // =====================================================================
  //  RetailPulse.Api — appsettings.Production.json
  // ---------------------------------------------------------------------
  //  Loaded automatically when ASPNETCORE_ENVIRONMENT=Production (layers
  //  over appsettings.json). This file documents the production surface
  //  with SAFE placeholders only.
  //
  //  SECRETS — NEVER COMMIT REAL VALUES HERE.
  //    Supply secrets at deploy time via environment variables (`:` -> `__`,
  //    e.g. OpenAI__ApimSubscriptionKey / OpenAI__ApiKey) or a secret store (Azure Key Vault / Container
  //    Apps secrets). These override the placeholders below at runtime.
  //
  //  REQUIRED IN PRODUCTION (the app fails fast at startup if missing):
  //    * OpenAI:ApimSubscriptionKey or OpenAI:ApiKey — set via OpenAI__ApimSubscriptionKey / OpenAI__ApiKey or a secret store
  //    * OpenAI:Endpoint     — your production APIM AI Gateway URL
  //    * Security:JwtAuthority / Security:JwtAudience — for bearer auth
  // =====================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ---- Data directory / durable storage --------------------------------
  // This synthetic demo runs in Production but has NO policy-compatible durable
  // volume (the account-key Azure Files mount was removed by the storage governance
  // hotfix; see docs/deployment-azd.md). Production would otherwise fail closed in
  // DataDirectoryResolver, so we EXPLICITLY opt in to a writable per-replica temp
  // directory here. This is honestly non-durable: audit/cost/memory/approval/alert
  // history lives only within the current replica and resets on replacement/redeploy.
  // The postprovision hook re-asserts this as an env var at deploy time. A future
  // policy-compatible durable backing should drop this and set a mounted data
  // directory instead. This is NOT the durable-storage requirement flag —
  // RETAIL_PULSE_REQUIRE_DURABLE_STORAGE=true still fails closed regardless.
  "RETAIL_PULSE_ALLOW_EPHEMERAL_STORAGE": "true",

  // ---- LLM / AI Gateway -------------------------------------------------
  "OpenAI": {
    // Preferred APIM caller credential. Leave empty here; inject at deploy time
    // via OpenAI__ApimSubscriptionKey / Container Apps secret reference.
    "ApimSubscriptionKey": "",
    // REQUIRED when bypassing APIM directly. Leave empty here; inject at deploy
    // time (OpenAI__ApiKey or a secret store). A blank value in Production
    // makes the app fail fast unless OpenAI__ApimSubscriptionKey is supplied.
    "ApiKey": "",
    // REQUIRED. Your production APIM AI Gateway (or Azure OpenAI) endpoint.
    "Endpoint": "https://<your-prod-apim-gateway>.azure-api.net/inference",
    "ApiVersion": "2025-03-01-preview",
    // Optional: separate deployment for the intent router.
    "RouterDeployment": ""
  },

  // ---- MCP tool server --------------------------------------------------
  // Internal service URL in your production environment.
  "McpServer": {
    "BaseUrl": "https://<your-mcpserver-host>"
  },

  // ---- CORS -------------------------------------------------------------
  // Production web origin(s). Used by Security:AllowedOrigins below as well.
  "Cors": {
    "AllowedOrigins": [
      "https://<your-production-web-domain>"
    ]
  },

  // ---- Authentication provider mode ------------------------------------
  // Production is EXPLICITLY PINNED to Entra — it does not merely inherit a default.
  // The API fails closed if this is missing or set to an unknown mode, and the
  // GitHub/Anonymous modes fail startup (they are never enabled in production). The
  // azd postprovision hook re-asserts Authentication__Mode=Entra at deploy time.
  "Authentication": {
    "Mode": "Entra"
  },

  // ---- Security / Auth --------------------------------------------------
  // Real Entra bearer auth is enforced in Production (no DevelopmentAuthHandler).
  // The default authorization policy requires an authenticated user, the
  // RetailPulse.User app role, and the access_as_user scope.
  "Security": {
    "RequireAuth": true,
    // Legacy fallbacks (still honoured, but prefer MicrosoftEntra below). Leave EMPTY here
    // and inject at deploy time — an angle-bracket placeholder is treated as unconfigured
    // and makes the app fail fast, so it can never masquerade as a real value.
    // e.g. https://login.microsoftonline.com/<tenant-id>/v2.0 (injected, not committed)
    "JwtAuthority": "",
    // The API's application (client) ID / audience (injected at deploy time).
    "JwtAudience": "",
    // Origins allowed by CORS in Production.
    "AllowedOrigins": [
      "https://<your-production-web-domain>"
    ]
  },

  // ---- Microsoft Entra (single-tenant SPA + API, PKCE, no client secret) --
  // REQUIRED in Production — the app fails fast at startup if TenantId or the
  // audience/ClientId is missing OR left as a placeholder. Tenant ID and client
  // ID are configuration, NOT secrets. Leave EMPTY here and inject at deploy time
  // from the Entra setup script output (MicrosoftEntra__TenantId / MicrosoftEntra__ClientId).
  "MicrosoftEntra": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "Audience": "",
    "ApiScope": "access_as_user",
    "AppRole": "RetailPulse.User"
  },

  // ---- Optional: Azure AI Foundry hosted agent --------------------------
  "FoundryAgent": {
    "Enabled": false,
    "ProjectEndpoint": "<your-foundry-project-endpoint>",
    "ShipmentAgentName": "Distribution Analysis Specialist",
    "ShipmentAgentId": "<your-agent-id>"
  },

  // ---- Telemetry --------------------------------------------------------
  // Connection string injected by the host (AppHost / Key Vault / env).
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "",
  "Telemetry": {
    // Keep false in production to avoid capturing prompt/completion content.
    "EnableSensitiveData": false
  },

  // ---- Proactive alerts background service ------------------------------
  "Alerts": {
    "CheckIntervalMinutes": 5
  },

  // ---- Knowledge base (RAG) limits --------------------------------------
  "Knowledge": {
    "MaxDocumentSizeBytes": 10485760,
    "MaxDocuments": 100,
    "MaxChunks": 5000
  },

  // ---- Observability store (in-memory cost/session caps) ----------------
  "Observability": {
    "MaxCostEvents": 10000,
    "CostEventTtlHours": 24,
    "MaxSessions": 1000,
    "MaxMessagesPerSession": 200
  },

  // ---- Tool-result cache ------------------------------------------------
  "ToolCache": {
    "Enabled": true,
    "DefaultTtlMinutes": 30,
    "ToolTtls": {
      "GetHistoricalDemand": 60,
      "GetSeasonalityFactors": 120,
      "GenerateForecast": 30,
      "IdentifyDemandRisks": 15,
      "GetShipmentStats": 10,
      "GetFieldSentiment": 15
    }
  },

  // ---- Per-model token pricing (powers the cost dashboard) --------------
  // USD per 1M tokens. Add/adjust models as needed; unknown models cost 0.
  "TokenPricing": {
    "gpt-5.5": { "InputPerMillion": 5.00, "OutputPerMillion": 30.00 },
    "gpt-5.5-mini": { "InputPerMillion": 0.50, "OutputPerMillion": 2.00 },
    "gpt-5.4-mini": { "InputPerMillion": 0.25, "OutputPerMillion": 2.00 },
    "gpt-4o": { "InputPerMillion": 2.50, "OutputPerMillion": 10.00 },
    "gpt-4o-mini": { "InputPerMillion": 0.15, "OutputPerMillion": 0.60 },
    "claude-opus-4.6": { "InputPerMillion": 5.00, "OutputPerMillion": 25.00 },
    "claude-sonnet-4.6": { "InputPerMillion": 3.00, "OutputPerMillion": 15.00 },
    "claude-haiku-4.5": { "InputPerMillion": 1.00, "OutputPerMillion": 5.00 }
  }
}
