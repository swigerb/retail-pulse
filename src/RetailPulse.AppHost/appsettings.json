{
  // =====================================================================
  //  RetailPulse.AppHost — appsettings.json (base / reference config)
  // ---------------------------------------------------------------------
  //  Checked-in reference config for the Aspire orchestrator. Safe
  //  defaults only — no secrets. The App Insights connection string is
  //  optional locally and is normally injected by the host / environment
  //  (set APPLICATIONINSIGHTS_CONNECTION_STRING via env or user-secrets).
  // =====================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  // Optional: leave empty to skip Application Insights (the Aspire
  // dashboard still works locally).
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
