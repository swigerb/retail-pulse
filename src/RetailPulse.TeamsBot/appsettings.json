{
  // =====================================================================
  //  RetailPulse.TeamsBot — appsettings.json (base / reference config)
  // ---------------------------------------------------------------------
  //  Checked-in reference config for the Teams bot. Safe placeholders
  //  only — NEVER commit a real ClientSecret. Supply bot credentials via
  //  user-secrets or environment variables (`:` maps to `__`, e.g.
  //  Connections__BotServiceConnection__Settings__ClientSecret).
  // =====================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ---- Teams bot runtime ------------------------------------------------
  "TeamsBot": {
    // API base URL when NOT running under Aspire (Aspire injects
    // 'services:api:https:0'). Defaults to http://localhost:5000 in Development.
    "ApiBaseUrl": "",
    // SignalR telemetry health behavior when the hub is unreachable.
    "HealthMode": "degraded",
    // Milliseconds to wait for telemetry flush after a turn.
    "TelemetryWaitMs": 500
  },

  // ---- Inbound SSO token validation -------------------------------------
  // Audiences accepted on incoming user tokens (your bot/app client IDs).
  "TokenValidation": {
    "Audiences": []
  },

  // ---- Bot Framework outbound auth (MSAL) -------------------------------
  // Placeholders only. Provide TenantId / ClientId / ClientSecret via
  // user-secrets or environment — do not commit real values.
  "Connections": {
    "BotServiceConnection": {
      "Assembly": "Microsoft.Agents.Authentication.Msal",
      "Type": "MsalAuth",
      "Settings": {
        "AuthType": "ClientSecret",
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{TenantId}}",
        "ClientId": "{{ClientId}}",
        "ClientSecret": "{{ClientSecret}}",
        "TenantId": "{{TenantId}}",
        "Scopes": ["https://api.botframework.com/.default"]
      }
    }
  },

  // ---- Telemetry --------------------------------------------------------
  // Optional. Injected by the host / environment in deployed setups.
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
