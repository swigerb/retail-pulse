# Retail Pulse frontend — supply-chain policy (Sprint 4, epic #27).
#
# The official public npm registry (registry.npmjs.org) is UNREACHABLE in this
# environment and MUST NOT be contacted. Every install/fetch is routed through the
# internal Microsoft package feed proxy instead.
#
#   registry               Points all metadata + tarball fetches at the internal proxy.
#   replace-registry-host  `always` rewrites the HOST of every `resolved` URL recorded
#                          in package-lock.json (canonical registry.npmjs.org URLs) to
#                          the proxy host at fetch time. The committed sha512 `integrity`
#                          hashes are still enforced against the downloaded bytes, so
#                          `npm ci` never rewrites the committed lockfile and supply-chain
#                          integrity is preserved — we only change WHERE bytes come from,
#                          never WHAT.
#
# Result: `npm ci` reproduces the exact locked tree via the proxy; no canonical
# registry hostname is ever contacted. Do NOT regenerate the lockfile against
# registry.npmjs.org and do NOT weaken integrity to sha1/unpinned packages.
registry=https://packagefeedproxy.microsoft.io/npm/
replace-registry-host=always

# Reproducible, non-interactive CI installs.
audit=false
fund=false
