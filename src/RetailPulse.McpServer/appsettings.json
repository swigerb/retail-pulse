{
  // =====================================================================
  //  RetailPulse.McpServer — appsettings.json (base / reference config)
  // ---------------------------------------------------------------------
  //  Checked-in reference config for the MCP tool server. Safe defaults
  //  only — no secrets. `:` maps to `__` as an environment variable
  //  (e.g. ApiKey:Value -> ApiKey__Value).
  // =====================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // ---- Optional API-key gate for incoming MCP requests ------------------
  // Disabled by default. When Enabled is true, requests must send the
  // configured key in the named header. Keep the real key in user-secrets
  // or an environment variable (ApiKey__Value) — never commit it.
  "ApiKey": {
    "Enabled": false,
    "Value": "",
    "Header": "X-Api-Key"
  },

  // ---- Telemetry --------------------------------------------------------
  // Optional. Injected by the host / environment in deployed setups.
  "APPLICATIONINSIGHTS_CONNECTION_STRING": ""
}
